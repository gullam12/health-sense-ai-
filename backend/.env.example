# HealthSense AI — Environment Variables
PROJECT_NAME="HealthSense AI Diagnostic Engine"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & Cryptography (SRS §6.0 AES-256 / JWT)
SECRET_KEY="healthsense-ai-super-secret-development-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Whitelist (Frontend React SPA)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Database Configuration (PostgreSQL 16 / Async SQLite for development fallback)
DATABASE_URL="sqlite+aiosqlite:///./healthsense.db"
# Production PostgreSQL URL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/healthsense_db"

# Supabase Cloud Database Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# Google Gemini AI Configuration
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"
