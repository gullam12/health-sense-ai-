# ==============================================================================
# HealthSense AI — Root .gitignore
# IEEE 830 / ISO/IEC/IEEE 29148 Standard Compliant
# Strictly protects secrets, credentials, environment files, and build outputs
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Credentials & Environment Files (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!*.env.example

# ------------------------------------------------------------------------------
# Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.output/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# ------------------------------------------------------------------------------
# Python & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
ENV/
env/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Testing & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml
coverage.lcov

# ------------------------------------------------------------------------------
# Local Databases & Sensitive Data Stores
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
backend/healthsense.db

# ------------------------------------------------------------------------------
# IDE, Editors & OS Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
